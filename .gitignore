# Dependencies and generated build output
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
build/
coverage/
*.tsbuildinfo

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
apps/api/.env
apps/web/.env.local
apps/admin/.env.local

# Prisma generated client and local database artifacts
apps/api/src/generated/prisma/
apps/api/prisma/src/generated/prisma/
*.db

# Locally uploaded media (local-disk storage adapter)
apps/api/uploads/

# OS/editor files
.DS_Store
.idea/
.vscode/
*.swp

# Local logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local client-demo recordings, traces and screenshots. These are large binary
# artefacts produced for a specific demo session and are never part of the
# source tree.
.local-demo-recordings/

# Playwright run output (screenshots, traces, error contexts). Never committed.
test-results/
playwright-report/

# Deterministic local visual-QA evidence. The runner is versioned, but its
# screenshots and JSON reports are intentionally local, run-specific output.
visual-qa/
