  acceptedTests             Json? @map("accepted_tests")
  intakeMonths              Json? @map("intake_months")
  postStudyWorkPermitMonths Int?  @map("post_study_work_permit_months")

  studentNationalities    StudentProfile[]          @relation("StudentNationality")
