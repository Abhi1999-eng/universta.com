  universityId     String    @map("university_id") @db.Char(36)
  genericCourseId  String    @map("generic_course_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  name             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  courseCode       String?   @map("course_code") @db.VarChar(100)
  shortDescription String?   @map("short_description") @db.VarChar(1000)
  overview         String?   @db.LongText
  courseLevelId    String?   @map("course_level_id") @db.Char(36)
  studyMode        String?   @map("study_mode") @db.VarChar(50)
  durationMin      Decimal?  @map("duration_min") @db.Decimal(6, 2)
  durationMax      Decimal?  @map("duration_max") @db.Decimal(6, 2)
  durationUnit     String?   @map("duration_unit") @db.VarChar(30)
  tuitionMin       Decimal?  @map("tuition_min") @db.Decimal(12, 2)
  tuitionMax       Decimal?  @map("tuition_max") @db.Decimal(12, 2)
  currencyCode     String?   @map("currency_code") @db.Char(3)
  tuitionPeriod    String?   @map("tuition_period") @db.VarChar(30)
  applicationUrl   String?   @map("application_url") @db.VarChar(2048)
  sourceReference  String?   @map("source_reference") @db.VarChar(2048)
  verifiedAt       DateTime? @map("verified_at") @db.DateTime(3)
  featuredMediaId  String?   @map("featured_media_id") @db.Char(36)
  status           String    @default("DRAFT") @db.VarChar(30)
  isFeatured       Boolean   @default(false) @map("is_featured")
  featuredPriority Int       @default(0) @map("featured_priority")
  featuredFrom     DateTime? @map("featured_from") @db.DateTime(3)
  featuredUntil    DateTime? @map("featured_until") @db.DateTime(3)
  publishStartsAt  DateTime? @map("publish_starts_at") @db.DateTime(3)
  publishEndsAt    DateTime? @map("publish_ends_at") @db.DateTime(3)
  displayOrder     Int       @default(0) @map("display_order")
  publishedAt      DateTime? @map("published_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  university          University                            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  genericCourse       Course                                @relation(fields: [genericCourseId], references: [id], onDelete: Restrict)
  campus              UniversityCampus?                     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  courseLevel         CourseLevel?                          @relation(fields: [courseLevelId], references: [id], onDelete: SetNull)
  intakes             UniversityCourseIntake[]
  requirements        UniversityCourseRequirement[]
  scholarships        ScholarshipUniversityCourseOffering[]
  successStories      SuccessStory[]
  testimonials        Testimonial[]
  studentSavedBy      StudentSavedOffering[]
  studentApplications StudentApplication[]

  @@unique([universityId, name])
  @@index([universityId, status, displayOrder])
  @@index([genericCourseId, status])
  @@index([campusId])
  @@index([courseLevelId])
  @@map("university_course_offerings")
}

