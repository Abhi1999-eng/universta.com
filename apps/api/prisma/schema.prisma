  @@index([status, isFeatured, isPopular])
  @@index([flagMediaId])
  @@index([listingMediaId])
  @@index([heroMediaId])
  @@index([mapMediaId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@fulltext([name, pageHeading, shortDescription])
  @@map("countries")
}

