/// Continents are soft-deleted, so uniqueness has to be scoped to the live
/// rows. `deletedKey` is the discriminator that makes that expressible as a
/// plain unique index: empty while the row is live, the row's own id once it
/// is deleted. Live rows therefore share the key and collide as intended,
/// while every deleted row carries a value nothing else can match — which is
/// what lets an admin recreate a continent they previously deleted.
model Continent {
  id               String    @id @default(uuid()) @db.Char(36)
  name             String    @db.VarChar(150)
  slug             String    @db.VarChar(150)
  code             String?   @db.VarChar(20)
  emoji            String?   @db.VarChar(20)
  shortDescription String?   @map("short_description") @db.VarChar(1000)
  overview         String?   @db.Text
  iconMediaId      String?   @map("icon_media_id") @db.Char(36)
  heroMediaId      String?   @map("hero_media_id") @db.Char(36)
  status           String    @default("ACTIVE") @db.VarChar(30)
  isFeatured       Boolean   @default(false) @map("is_featured")
  displayOrder     Int       @default(0) @map("display_order")
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  updatedByUserId  String?   @map("updated_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  deletedKey       String    @default("") @map("deleted_key") @db.Char(36)

  iconMedia MediaAsset? @relation("ContinentIconMedia", fields: [iconMediaId], references: [id], onDelete: SetNull)
  heroMedia MediaAsset? @relation("ContinentHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("ContinentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("ContinentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  countries Country[]

  @@unique([name, deletedKey], map: "continents_name_deleted_key")
  @@unique([slug, deletedKey], map: "continents_slug_deleted_key")
  @@unique([code, deletedKey], map: "continents_code_deleted_key")
  @@index([iconMediaId])
  @@index([heroMediaId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([status, displayOrder])
  @@map("continents")
}

