generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id           String   @id @default(uuid()) @db.Char(36)
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  isSystemRole Boolean  @default(false) @map("is_system_role")
  status       String   @default("ACTIVE") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid()) @db.Char(36)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  firstName           String    @map("first_name") @db.VarChar(100)
  lastName            String?   @map("last_name") @db.VarChar(100)
  phoneCountryCode    String?   @map("phone_country_code") @db.VarChar(10)
  phoneNumber         String?   @map("phone_number") @db.VarChar(30)
  avatarMediaId       String?   @map("avatar_media_id") @db.Char(36)
  status              String    @default("ACTIVE") @db.VarChar(30)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.DateTime(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.DateTime(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(3)
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  timezone            String    @default("Asia/Kolkata") @db.VarChar(100)
  locale              String    @default("en-IN") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime? @map("deleted_at") @db.DateTime(3)

  avatarMedia                  MediaAsset?                    @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  userRoles                    UserRole[]
  assignedUserRoles            UserRole[]                     @relation("UserRoleAssigner")
  refreshTokens                RefreshToken[]
  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  studentProfile               StudentProfile?
  studentMessages              StudentMessage[]               @relation("StudentMessageSender")
  internalMessages             StudentMessage[]               @relation("InternalMessageSender")
  applicationStatusChanges     StudentApplicationTimeline[]   @relation("ApplicationStatusChangedBy")
  scholarshipStatusChanges     StudentScholarshipTimeline[]   @relation("ScholarshipStatusChangedBy")
  supportStatusChanges         StudentSupportTicket[]         @relation("SupportStatusChangedBy")
  supportMessages              StudentSupportMessage[]        @relation("SupportMessageSender")
  loginAttempts                LoginAttempt[]
  auditLogs                    AuditLog[]
  uploadedMedia                MediaAsset[]                   @relation("MediaUploadedBy")
  updatedSettings              SiteSetting[]                  @relation("SiteSettingUpdatedBy")
  createdPages                 Page[]                         @relation("PageCreatedBy")
  updatedPages                 Page[]                         @relation("PageUpdatedBy")
  createdPageTemplates         PageTemplate[]                 @relation("PageTemplateCreatedBy")
  updatedPageTemplates         PageTemplate[]                 @relation("PageTemplateUpdatedBy")
  contentVersions              ContentVersion[]               @relation("ContentVersionCreatedBy")
  createdExperiments           Experiment[]                   @relation("ExperimentCreatedBy")
  createdSubjects              Subject[]                      @relation("SubjectCreatedBy")
  updatedSubjects              Subject[]                      @relation("SubjectUpdatedBy")
  createdSubSubjects           SubSubject[]                   @relation("SubSubjectCreatedBy")
  updatedSubSubjects           SubSubject[]                   @relation("SubSubjectUpdatedBy")
  createdCountries             Country[]                      @relation("CountryCreatedBy")
  updatedCountries             Country[]                      @relation("CountryUpdatedBy")
  createdCities                City[]                         @relation("CityCreatedBy")
  updatedCities                City[]                         @relation("CityUpdatedBy")
  createdCountryFaqs           CountryFaq[]                   @relation("CountryFaqCreatedBy")
  updatedCountryFaqs           CountryFaq[]                   @relation("CountryFaqUpdatedBy")
  createdCourses               Course[]                       @relation("CourseCreatedBy")
  updatedCourses               Course[]                       @relation("CourseUpdatedBy")
  assignedLeads                Lead[]                         @relation("LeadAssignedTo")
  assignedBookings             CounsellingBooking[]           @relation("BookingAssignedTo")
  reviewedUniversityClaims     UniversityClaimRequest[]       @relation("UniversityClaimReviewedBy")
  universityClaimNotes         UniversityClaimNote[]
  universityClaimStatusChanges UniversityClaimStatusHistory[] @relation("UniversityClaimStatusChangedBy")
  leadNotes                    LeadNote[]
  changedLeadStatuses          LeadStatusHistory[]            @relation("LeadStatusChangedBy")
  createdEmailTemplates        EmailTemplate[]                @relation("EmailTemplateCreatedBy")
  updatedEmailTemplates        EmailTemplate[]                @relation("EmailTemplateUpdatedBy")
  createdRedirects             Redirect[]                     @relation("RedirectCreatedBy")
  createdContinents            Continent[]                    @relation("ContinentCreatedBy")
  updatedContinents            Continent[]                    @relation("ContinentUpdatedBy")
  convertedContactInquiries    ContactInquiry[]               @relation("ContactInquiryConvertedBy")

  @@index([avatarMediaId])
  @@index([status, deletedAt])
  @@map("users")
}

model UserRole {
  id               String   @id @default(uuid()) @db.Char(36)
  userId           String   @map("user_id") @db.Char(36)
  roleId           String   @map("role_id") @db.Char(36)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Char(36)
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(255)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Char(36)
  /// How many read-only session validations this token has satisfied *after*
  /// being rotated away. Bounded so a superseded token cannot be replayed
  /// indefinitely by a navigation that raced the rotation.
  graceUseCount     Int       @default(0) @map("grace_use_count")
  createdIp         String?   @map("created_ip") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(1000)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces        RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([replacedByTokenId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  usedAt      DateTime? @map("used_at") @db.DateTime(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Proves a person controls the address they registered with. Only the hash is
/// stored, so a leaked row cannot be replayed; `usedAt` makes a token
/// single-use and `expiresAt` bounds the window.
model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  email       String    @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  usedAt      DateTime? @map("used_at") @db.DateTime(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

model LoginAttempt {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String?  @map("user_id") @db.Char(36)
  attemptedEmail String   @map("attempted_email") @db.VarChar(255)
  wasSuccessful  Boolean  @map("was_successful")
  failureReason  String?  @map("failure_reason") @db.VarChar(255)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(1000)
  requestId      String?  @map("request_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([attemptedEmail, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  module      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Char(36)
  action      String   @db.VarChar(50)
  oldValues   Json?    @map("old_values") @db.Json
  newValues   Json?    @map("new_values") @db.Json
  description String?  @db.VarChar(1000)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(1000)
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([module, action, createdAt])
  @@map("audit_logs")
}

model MediaAsset {
  id               String    @id @default(uuid()) @db.Char(36)
  storageProvider  String    @default("LOCAL") @map("storage_provider") @db.VarChar(30)
  bucketName       String?   @map("bucket_name") @db.VarChar(255)
  objectKey        String    @map("object_key") @db.VarChar(1000)
  publicUrl        String    @map("public_url") @db.VarChar(2048)
  originalFileName String    @map("original_file_name") @db.VarChar(500)
  storedFileName   String    @map("stored_file_name") @db.VarChar(500)
  mimeType         String    @map("mime_type") @db.VarChar(150)
  fileExtension    String?   @map("file_extension") @db.VarChar(20)
  fileSizeBytes    BigInt    @map("file_size_bytes") @db.BigInt
  width            Int?      @db.Int
  height           Int?      @db.Int
  durationSeconds  Int?      @map("duration_seconds") @db.Int
  checksum         String?   @db.VarChar(128)
  title            String?   @db.VarChar(255)
  altText          String?   @map("alt_text") @db.VarChar(500)
  caption          String?   @db.Text
  folder           String?   @db.VarChar(255)
  mediaType        String    @default("IMAGE") @map("media_type") @db.VarChar(30)
  status           String    @default("ACTIVE") @db.VarChar(30)
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  uploadedBy               User?                   @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  avatarUsers              User[]                  @relation("UserAvatar")
  pageSections             PageSection[]           @relation("PageSectionMedia")
  backgroundSections       PageSection[]           @relation("PageSectionBackgroundMedia")
  navigationIcons          NavigationItem[]        @relation("NavigationItemIconMedia")
  platformMetrics          PlatformMetric[]        @relation("PlatformMetricIconMedia")
  seoOgMetadata            SeoMetadata[]           @relation("SeoOgMedia")
  seoTwitterMetadata       SeoMetadata[]           @relation("SeoTwitterMedia")
  continentIcons           Continent[]             @relation("ContinentIconMedia")
  continentHeroes          Continent[]             @relation("ContinentHeroMedia")
  subjectIcons             Subject[]               @relation("SubjectIconMedia")
  subjectListingMedia      Subject[]               @relation("SubjectListingMedia")
  subjectHeroMedia         Subject[]               @relation("SubjectHeroMedia")
  subSubjectIcons          SubSubject[]            @relation("SubSubjectIconMedia")
  subSubjectListingMedia   SubSubject[]            @relation("SubSubjectListingMedia")
  countryFlags             Country[]               @relation("CountryFlagMedia")
  countryListingMedia      Country[]               @relation("CountryListingMedia")
  countryHeroMedia         Country[]               @relation("CountryHeroMedia")
  countryMapMedia          Country[]               @relation("CountryMapMedia")
  cityHeroMedia            City[]                  @relation("CityHeroMedia")
  countryPrimarySections   CountryContentSection[] @relation("CountryPrimaryMedia")
  countrySecondarySections CountryContentSection[] @relation("CountrySecondaryMedia")
  courseFeaturedMedia      Course[]                @relation("CourseFeaturedMedia")
  courseSections           CourseContentSection[]  @relation("CourseSectionMedia")
  consultantIcons          ConsultantLandingCard[] @relation("ConsultantIconMedia")
  consultantFeaturedMedia  ConsultantLandingCard[] @relation("ConsultantFeaturedMedia")

  studentEnglishTestResults StudentEnglishTest[] @relation("StudentEnglishTestResult")
  studentPassportScans      StudentPassport[]    @relation("StudentPassportScan")
  studentDocuments          StudentDocument[]    @relation("StudentDocumentMedia")
  applicationOffers         StudentApplication[] @relation("StudentApplicationOfferMedia")

  @@index([uploadedByUserId])
  @@index([folder, status])
  @@index([checksum])
  @@map("media_assets")
}

model SiteSetting {
  id              String   @id @default(uuid()) @db.Char(36)
  settingKey      String   @unique @map("setting_key") @db.VarChar(150)
  settingGroup    String   @map("setting_group") @db.VarChar(100)
  valueType       String   @map("value_type") @db.VarChar(30)
  valueJson       Json?    @map("value_json") @db.Json
  description     String?  @db.VarChar(500)
  isPublic        Boolean  @default(false) @map("is_public")
  updatedByUserId String?  @map("updated_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation("SiteSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@index([settingGroup, isPublic])
  @@map("site_settings")
}

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Char(36)
  flagKey           String   @unique @map("flag_key") @db.VarChar(150)
  name              String   @db.VarChar(255)
  description       String?  @db.VarChar(500)
  isEnabled         Boolean  @default(false) @map("is_enabled")
  environment       String   @default("ALL") @db.VarChar(30)
  configurationJson Json?    @map("configuration_json") @db.Json
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("feature_flags")
}

model Page {
  id               String    @id @default(uuid()) @db.Char(36)
  pageType         String    @map("page_type") @db.VarChar(50)
  title            String    @db.VarChar(255)
  shortTitle       String?   @map("short_title") @db.VarChar(150)
  slug             String    @unique @db.VarChar(255)
  layoutKey        String?   @map("layout_key") @db.VarChar(100)
  templateId       String?   @map("template_id") @db.Char(36)
  shortDescription String?   @map("short_description") @db.VarChar(1000)
  /// Optional per-page Header/Footer override. NULL means "use the Global
  /// Header/Footer", which is what every existing page resolves to, so adding
  /// this column changes nothing that is already published.
  chromeConfigJson Json?     @map("chrome_config_json") @db.Json
  status           String    @default("DRAFT") @db.VarChar(30)
  isHomepage       Boolean   @default(false) @map("is_homepage")
  displayOrder     Int       @default(0) @map("display_order")
  publishedAt      DateTime? @map("published_at") @db.DateTime(3)
  startsAt         DateTime? @map("starts_at") @db.DateTime(3)
  endsAt           DateTime? @map("ends_at") @db.DateTime(3)
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  updatedByUserId  String?   @map("updated_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  createdBy       User?            @relation("PageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("PageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  template        PageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections        PageSection[]
  navigationItems NavigationItem[]

  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([pageType, status, displayOrder])
  @@index([templateId])
  @@map("pages")
}

model PageTemplate {
  id                  String    @id @default(uuid()) @db.Char(36)
  name                String    @db.VarChar(255)
  templateKey         String    @unique @map("template_key") @db.VarChar(100)
  description         String?   @db.VarChar(1000)
  pageFamily          String    @map("page_family") @db.VarChar(60)
  defaultSectionsJson Json      @map("default_sections_json") @db.Json
  layoutConfigJson    Json?     @map("layout_config_json") @db.Json
  /// Same contract as Page.chromeConfigJson, applied to every dynamic detail
  /// page rendered through this template. A page's own override wins over it.
  chromeConfigJson    Json?     @map("chrome_config_json") @db.Json
  isActive            Boolean   @default(true) @map("is_active")
  createdByUserId     String?   @map("created_by_user_id") @db.Char(36)
  updatedByUserId     String?   @map("updated_by_user_id") @db.Char(36)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime? @map("deleted_at") @db.DateTime(3)

  createdBy User?  @relation("PageTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("PageTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  pages     Page[]

  @@index([pageFamily, isActive])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("page_templates")
}

model PageSection {
  id                String    @id @default(uuid()) @db.Char(36)
  pageId            String    @map("page_id") @db.Char(36)
  sectionKey        String    @map("section_key") @db.VarChar(100)
  sectionType       String    @map("section_type") @db.VarChar(100)
  eyebrow           String?   @db.VarChar(255)
  heading           String?   @db.VarChar(500)
  subheading        String?   @db.Text
  bodyJson          Json?     @map("body_json") @db.Json
  mediaId           String?   @map("media_id") @db.Char(36)
  backgroundMediaId String?   @map("background_media_id") @db.Char(36)
  ctaPrimaryLabel   String?   @map("cta_primary_label") @db.VarChar(100)
  ctaPrimaryUrl     String?   @map("cta_primary_url") @db.VarChar(1000)
  ctaSecondaryLabel String?   @map("cta_secondary_label") @db.VarChar(100)
  ctaSecondaryUrl   String?   @map("cta_secondary_url") @db.VarChar(1000)
  configurationJson Json?     @map("configuration_json") @db.Json
  displayOrder      Int       @default(0) @map("display_order")
  status            String    @default("ACTIVE") @db.VarChar(30)
  startsAt          DateTime? @map("starts_at") @db.DateTime(3)
  endsAt            DateTime? @map("ends_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)

  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media           MediaAsset?  @relation("PageSectionMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  backgroundMedia MediaAsset?  @relation("PageSectionBackgroundMedia", fields: [backgroundMediaId], references: [id], onDelete: SetNull)
  experiments     Experiment[]

  @@unique([pageId, sectionKey])
  @@index([pageId, status, displayOrder])
  @@index([mediaId])
  @@index([backgroundMediaId])
  @@map("page_sections")
}

model Experiment {
  id              String    @id @default(uuid()) @db.Char(36)
  key             String    @unique @db.VarChar(150)
  name            String    @db.VarChar(255)
  description     String?   @db.VarChar(1000)
  sectionId       String    @map("section_id") @db.Char(36)
  status          String    @default("DRAFT") @db.VarChar(30)
  startsAt        DateTime? @map("starts_at") @db.DateTime(3)
  endsAt          DateTime? @map("ends_at") @db.DateTime(3)
  createdByUserId String?   @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  section     PageSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("ExperimentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  variants    ExperimentVariant[]
  exposures   ExperimentExposure[]
  conversions ExperimentConversion[]

  @@index([sectionId, status])
  @@index([createdByUserId])
  @@map("experiments")
}

model ExperimentVariant {
  id              String    @id @default(uuid()) @db.Char(36)
  experimentId    String    @map("experiment_id") @db.Char(36)
  key             String    @db.VarChar(100)
  name            String    @db.VarChar(255)
  isControl       Boolean   @default(false) @map("is_control")
  trafficWeight   Int       @default(0) @map("traffic_weight")
  eyebrow         String?   @db.VarChar(255)
  heading         String?   @db.VarChar(500)
  subheading      String?   @db.Text
  ctaPrimaryLabel String?   @map("cta_primary_label") @db.VarChar(100)
  ctaPrimaryUrl   String?   @map("cta_primary_url") @db.VarChar(1000)
  displayOrder    Int       @default(0) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  experiment  Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  exposures   ExperimentExposure[]
  conversions ExperimentConversion[]

  @@unique([experimentId, key])
  @@map("experiment_variants")
}

model ExperimentExposure {
  id           String   @id @default(uuid()) @db.Char(36)
  experimentId String   @map("experiment_id") @db.Char(36)
  variantId    String   @map("variant_id") @db.Char(36)
  anonymousId  String   @map("anonymous_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  experiment Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([experimentId, variantId])
  @@map("experiment_exposures")
}

model ExperimentConversion {
  id           String   @id @default(uuid()) @db.Char(36)
  experimentId String   @map("experiment_id") @db.Char(36)
  variantId    String   @map("variant_id") @db.Char(36)
  anonymousId  String   @map("anonymous_id") @db.VarChar(100)
  kind         String   @db.VarChar(50)
