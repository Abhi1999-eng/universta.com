/// Version history for Website Builder content.
///
/// One table for every versioned resource rather than a snapshot column per
/// model: the Admin list, compare and restore flows are identical across
/// Pages, Page Sections, Page Templates and the Global Header/Footer settings
/// groups, and a single table keeps them that way.
///
/// `snapshotJson` holds the full state of the resource at that point, so a
/// restore never has to reconstruct anything from diffs. `versionNumber` is
/// per-resource and monotonic: a restore appends a new highest version rather
/// than rewinding the counter, so later history is never lost.
model ContentVersion {
  id                  String   @id @default(uuid()) @db.Char(36)
  /// PAGE | PAGE_SECTION | PAGE_TEMPLATE | GLOBAL_HEADER | GLOBAL_FOOTER
  resourceType        String   @map("resource_type") @db.VarChar(40)
  /// Page/section/template id, or the settings group key for header/footer.
  resourceId          String   @map("resource_id") @db.VarChar(150)
  versionNumber       Int      @map("version_number")
  snapshotJson        Json     @map("snapshot_json") @db.Json
  /// Human-readable summary of what changed, shown in the Admin list.
  changeSummary       String   @map("change_summary") @db.VarChar(500)
  /// The editor action that produced this version (update, reorder,
  /// visibility, publish, restore, ...), for filtering and audit.
  sourceAction        String   @map("source_action") @db.VarChar(60)
  /// Set only on versions produced by a restore, naming the version restored.
  restoredFromVersion Int?     @map("restored_from_version")
  createdByUserId     String?  @map("created_by_user_id") @db.Char(36)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)

  createdBy User? @relation("ContentVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([resourceType, resourceId, versionNumber])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdByUserId])
  @@map("content_versions")
}

// ===========================================================================
// Student domain (Phase 2-A)
//
// `User` stays identity and account: credentials, status, roles. Everything a
// student tells us about themselves lives here instead, so the account table
// does not grow a column per question we ever ask. Catalogue master data
// (Country, Subject, CourseLevel, Intake) is referenced, never copied.
// ===========================================================================

model StudentProfile {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @map("user_id") @db.Char(36)

  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?   @db.VarChar(30)
  nationalityCountryId String?   @map("nationality_country_id") @db.Char(36)
  currentCountryId     String?   @map("current_country_id") @db.Char(36)
  currentCityText      String?   @map("current_city_text") @db.VarChar(150)
  address              String?   @db.VarChar(500)
  postalCode           String?   @map("postal_code") @db.VarChar(20)

  // Study preferences. Single-value preferences are foreign keys; the
  // destinations a student is open to are many, so they get a join table.
  preferredSubjectId     String?  @map("preferred_subject_id") @db.Char(36)
  preferredCourseLevelId String?  @map("preferred_course_level_id") @db.Char(36)
  preferredIntakeId      String?  @map("preferred_intake_id") @db.Char(36)
  budgetMin              Decimal? @map("budget_min") @db.Decimal(12, 2)
  budgetMax              Decimal? @map("budget_max") @db.Decimal(12, 2)
  budgetCurrency         String?  @map("budget_currency") @db.VarChar(3)
  referralCode           String?  @unique @map("referral_code") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user                    User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalityCountry      Country?                        @relation("StudentNationality", fields: [nationalityCountryId], references: [id], onDelete: SetNull)
  currentCountry          Country?                        @relation("StudentCurrentCountry", fields: [currentCountryId], references: [id], onDelete: SetNull)
  preferredSubject        Subject?                        @relation("StudentPreferredSubject", fields: [preferredSubjectId], references: [id], onDelete: SetNull)
  preferredCourseLevel    CourseLevel?                    @relation("StudentPreferredCourseLevel", fields: [preferredCourseLevelId], references: [id], onDelete: SetNull)
  preferredIntake         Intake?                         @relation("StudentPreferredIntake", fields: [preferredIntakeId], references: [id], onDelete: SetNull)
  preferredCountries      StudentPreferredCountry[]
  academicRecords         StudentAcademicRecord[]
  workExperiences         StudentWorkExperience[]
  englishTests            StudentEnglishTest[]
  passport                StudentPassport?
  documents               StudentDocument[]
  savedUniversities       StudentSavedUniversity[]
  savedOfferings          StudentSavedOffering[]
  savedScholarships       StudentSavedScholarship[]
  applications            StudentApplication[]
  scholarshipApplications StudentScholarshipApplication[]
  consultantAssignments   StudentConsultantAssignment[]
  conversations           StudentConversation[]
  notifications           StudentNotification[]
  supportTickets          StudentSupportTicket[]
  referralsMade           StudentReferral[]               @relation("StudentReferralReferrer")
  referralReceived        StudentReferral?                @relation("StudentReferralReferred")

  @@index([nationalityCountryId])
  @@index([currentCountryId])
  @@map("student_profiles")
}

model StudentPreferredCountry {
  studentProfileId String @map("student_profile_id") @db.Char(36)
  countryId        String @map("country_id") @db.Char(36)
  displayOrder     Int    @default(0) @map("display_order")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  country        Country        @relation("StudentPreferredCountry", fields: [countryId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, countryId])
  @@index([countryId])
  @@map("student_preferred_countries")
}

/// One row per qualification. Deliberately text-based for institution and board
/// names: encoding every education system in the world is not the job here.
model StudentAcademicRecord {
  id               String @id @default(uuid()) @db.Char(36)
  studentProfileId String @map("student_profile_id") @db.Char(36)

  qualificationName  String    @map("qualification_name") @db.VarChar(200)
  qualificationLevel String?   @map("qualification_level") @db.VarChar(60)
  institutionName    String    @map("institution_name") @db.VarChar(200)
  boardOrUniversity  String?   @map("board_or_university") @db.VarChar(200)
  countryId          String?   @map("country_id") @db.Char(36)
  specialization     String?   @db.VarChar(200)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  currentlyStudying  Boolean   @default(false) @map("currently_studying")
  percentage         Decimal?  @db.Decimal(5, 2)
  gpa                Decimal?  @db.Decimal(5, 2)
  gpaScale           Decimal?  @map("gpa_scale") @db.Decimal(5, 2)
  notes              String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  country        Country?       @relation("StudentAcademicCountry", fields: [countryId], references: [id], onDelete: SetNull)

  @@index([studentProfileId])
  @@index([countryId])
  @@map("student_academic_records")
}

model StudentWorkExperience {
  id               String @id @default(uuid()) @db.Char(36)
  studentProfileId String @map("student_profile_id") @db.Char(36)

  companyName      String    @map("company_name") @db.VarChar(200)
  jobTitle         String    @map("job_title") @db.VarChar(200)
  employmentType   String?   @map("employment_type") @db.VarChar(40)
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  currentlyWorking Boolean   @default(false) @map("currently_working")
  description      String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("student_work_experiences")
}

/// Component scores are JSON because each exam scores different things: IELTS
/// has four bands, PTE and TOEFL do not match them one to one, and dedicated
/// columns for one exam make every other exam awkward.
model StudentEnglishTest {
  id               String @id @default(uuid()) @db.Char(36)
  studentProfileId String @map("student_profile_id") @db.Char(36)

  testType        String    @map("test_type") @db.VarChar(30)
  testDate        DateTime? @map("test_date") @db.Date
  overallScore    Decimal   @map("overall_score") @db.Decimal(5, 2)
  componentScores Json?     @map("component_scores")
  expiryDate      DateTime? @map("expiry_date") @db.Date
  resultMediaId   String?   @map("result_media_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  resultMedia    MediaAsset?    @relation("StudentEnglishTestResult", fields: [resultMediaId], references: [id], onDelete: SetNull)

  @@index([studentProfileId])
  @@map("student_english_tests")
}

/// Sensitive. Read and written only through the owner's own endpoint, never
/// included in list responses, and never written to logs or audit descriptions.
model StudentPassport {
  id               String @id @default(uuid()) @db.Char(36)
  studentProfileId String @unique @map("student_profile_id") @db.Char(36)

  passportNumber   String    @map("passport_number") @db.VarChar(60)
  issuingCountryId String?   @map("issuing_country_id") @db.Char(36)
  issueDate        DateTime? @map("issue_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  passportMediaId  String?   @map("passport_media_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  issuingCountry Country?       @relation("StudentPassportCountry", fields: [issuingCountryId], references: [id], onDelete: SetNull)
  passportMedia  MediaAsset?    @relation("StudentPassportScan", fields: [passportMediaId], references: [id], onDelete: SetNull)

  @@index([issuingCountryId])
  @@map("student_passports")
}

/// Ownership metadata for a file already stored as a MediaAsset. The bytes stay
/// in media storage; this row is what makes a file *this student's*.
model StudentDocument {
  id               String @id @default(uuid()) @db.Char(36)
  studentProfileId String @map("student_profile_id") @db.Char(36)
  mediaAssetId     String @map("media_asset_id") @db.Char(36)

  documentType String  @map("document_type") @db.VarChar(40)
  title        String  @db.VarChar(255)
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  studentProfile              StudentProfile               @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mediaAsset                  MediaAsset                   @relation("StudentDocumentMedia", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  applicationLinks            StudentApplicationDocument[]
  scholarshipApplicationLinks StudentScholarshipDocument[]

  @@index([studentProfileId])
  @@index([studentProfileId, documentType])
  @@index([mediaAssetId])
  @@map("student_documents")
}

// Phase 2 lifecycle records deliberately keep catalogue relationships as
// foreign keys. Display snapshots are limited to the name a student saw at the
// moment they started an application, so historical pages remain readable
// after a catalogue item is withdrawn without copying catalogue payloads.
model StudentSavedUniversity {
  studentProfileId String         @map("student_profile_id") @db.Char(36)
  universityId     String         @map("university_id") @db.Char(36)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  university       University     @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, universityId])
  @@index([universityId])
  @@map("student_saved_universities")
}

model StudentSavedOffering {
  studentProfileId String                   @map("student_profile_id") @db.Char(36)
  offeringId       String                   @map("offering_id") @db.Char(36)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  studentProfile   StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  offering         UniversityCourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, offeringId])
  @@index([offeringId])
  @@map("student_saved_offerings")
}

model StudentSavedScholarship {
  studentProfileId String         @map("student_profile_id") @db.Char(36)
  scholarshipId    String         @map("scholarship_id") @db.Char(36)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  scholarship      Scholarship    @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, scholarshipId])
  @@index([scholarshipId])
  @@map("student_saved_scholarships")
}

model StudentApplication {
  id                     String                       @id @default(uuid()) @db.Char(36)
  studentProfileId       String                       @map("student_profile_id") @db.Char(36)
  universityId           String                       @map("university_id") @db.Char(36)
  offeringId             String?                      @map("offering_id") @db.Char(36)
  targetIntakeId         String?                      @map("target_intake_id") @db.Char(36)
  status                 String                       @default("APPLICATION_STARTED") @db.VarChar(40)
  universityNameSnapshot String                       @map("university_name_snapshot") @db.VarChar(255)
  offeringNameSnapshot   String?                      @map("offering_name_snapshot") @db.VarChar(255)
  submittedAt            DateTime?                    @map("submitted_at") @db.DateTime(3)
  decisionAt             DateTime?                    @map("decision_at") @db.DateTime(3)
  offerMediaId           String?                      @map("offer_media_id") @db.Char(36)
  offerDecision          String?                      @map("offer_decision") @db.VarChar(20)
  offerDecisionAt        DateTime?                    @map("offer_decision_at") @db.DateTime(3)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  studentProfile         StudentProfile               @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  university             University                   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  offering               UniversityCourseOffering?    @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  targetIntake           Intake?                      @relation(fields: [targetIntakeId], references: [id], onDelete: SetNull)
  offerMedia             MediaAsset?                  @relation("StudentApplicationOfferMedia", fields: [offerMediaId], references: [id], onDelete: SetNull)
  timeline               StudentApplicationTimeline[]
  documents              StudentApplicationDocument[]

  @@index([studentProfileId, status, updatedAt])
  @@index([universityId])
  @@index([offeringId])
  @@map("student_applications")
}

model StudentApplicationTimeline {
  id              String             @id @default(uuid()) @db.Char(36)
  applicationId   String             @map("application_id") @db.Char(36)
  status          String             @db.VarChar(40)
  message         String?            @db.VarChar(1000)
  actorType       String             @map("actor_type") @db.VarChar(20)
  changedByUserId String?            @map("changed_by_user_id") @db.Char(36)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  application     StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy       User?              @relation("ApplicationStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("student_application_timeline")
}

model StudentApplicationDocument {
  applicationId     String             @map("application_id") @db.Char(36)
  studentDocumentId String             @map("student_document_id") @db.Char(36)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  application       StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentDocument   StudentDocument    @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)

  @@id([applicationId, studentDocumentId])
  @@index([studentDocumentId])
  @@map("student_application_documents")
}

model StudentScholarshipApplication {
  id                       String                       @id @default(uuid()) @db.Char(36)
  studentProfileId         String                       @map("student_profile_id") @db.Char(36)
  scholarshipId            String                       @map("scholarship_id") @db.Char(36)
  status                   String                       @default("STARTED") @db.VarChar(30)
  scholarshipTitleSnapshot String                       @map("scholarship_title_snapshot") @db.VarChar(255)
  submittedAt              DateTime?                    @map("submitted_at") @db.DateTime(3)
  decisionAt               DateTime?                    @map("decision_at") @db.DateTime(3)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  studentProfile           StudentProfile               @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  scholarship              Scholarship                  @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  timeline                 StudentScholarshipTimeline[]
  documents                StudentScholarshipDocument[]

  @@unique([studentProfileId, scholarshipId])
  @@index([studentProfileId, status, updatedAt])
  @@map("student_scholarship_applications")
}

model StudentScholarshipTimeline {
  id                       String                        @id @default(uuid()) @db.Char(36)
  scholarshipApplicationId String                        @map("scholarship_application_id") @db.Char(36)
  status                   String                        @db.VarChar(30)
  message                  String?                       @db.VarChar(1000)
  actorType                String                        @map("actor_type") @db.VarChar(20)
  changedByUserId          String?                       @map("changed_by_user_id") @db.Char(36)
  createdAt                DateTime                      @default(now()) @map("created_at") @db.DateTime(3)
  scholarshipApplication   StudentScholarshipApplication @relation(fields: [scholarshipApplicationId], references: [id], onDelete: Cascade)
  changedBy                User?                         @relation("ScholarshipStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([scholarshipApplicationId, createdAt])
  @@map("student_scholarship_timeline")
}

model StudentScholarshipDocument {
  scholarshipApplicationId String                        @map("scholarship_application_id") @db.Char(36)
  studentDocumentId        String                        @map("student_document_id") @db.Char(36)
  scholarshipApplication   StudentScholarshipApplication @relation(fields: [scholarshipApplicationId], references: [id], onDelete: Cascade)
  studentDocument          StudentDocument               @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)

  @@id([scholarshipApplicationId, studentDocumentId])
  @@index([studentDocumentId])
  @@map("student_scholarship_documents")
}

model StudentConsultantAssignment {
  id               String                @id @default(uuid()) @db.Char(36)
  studentProfileId String                @map("student_profile_id") @db.Char(36)
  consultantId     String                @map("consultant_id") @db.Char(36)
  status           String                @default("ACTIVE") @db.VarChar(20)
  assignedAt       DateTime              @default(now()) @map("assigned_at") @db.DateTime(3)
  endedAt          DateTime?             @map("ended_at") @db.DateTime(3)
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  consultant       Consultant            @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  conversations    StudentConversation[]

  @@index([studentProfileId, status])
  @@index([consultantId, status])
  @@map("student_consultant_assignments")
}

model StudentConversation {
  id                     String                       @id @default(uuid()) @db.Char(36)
  studentProfileId       String                       @map("student_profile_id") @db.Char(36)
  consultantAssignmentId String?                      @map("consultant_assignment_id") @db.Char(36)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  studentProfile         StudentProfile               @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  consultantAssignment   StudentConsultantAssignment? @relation(fields: [consultantAssignmentId], references: [id], onDelete: SetNull)
  messages               StudentMessage[]

  @@index([studentProfileId, updatedAt])
  @@map("student_conversations")
}

model StudentMessage {
  id               String              @id @default(uuid()) @db.Char(36)
  conversationId   String              @map("conversation_id") @db.Char(36)
  senderType       String              @map("sender_type") @db.VarChar(20)
  studentSenderId  String?             @map("student_sender_id") @db.Char(36)
  internalSenderId String?             @map("internal_sender_id") @db.Char(36)
  body             String              @db.Text
  readAt           DateTime?           @map("read_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  conversation     StudentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  studentSender    User?               @relation("StudentMessageSender", fields: [studentSenderId], references: [id], onDelete: SetNull)
  internalSender   User?               @relation("InternalMessageSender", fields: [internalSenderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("student_messages")
}

model StudentNotification {
  id               String         @id @default(uuid()) @db.Char(36)
  studentProfileId String         @map("student_profile_id") @db.Char(36)
  type             String         @db.VarChar(50)
  title            String         @db.VarChar(255)
  body             String?        @db.VarChar(1000)
  href             String?        @db.VarChar(2048)
  readAt           DateTime?      @map("read_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, readAt, createdAt])
  @@map("student_notifications")
}

model StudentSupportTicket {
  id                  String                  @id @default(uuid()) @db.Char(36)
  studentProfileId    String                  @map("student_profile_id") @db.Char(36)
  category            String                  @db.VarChar(30)
  subject             String                  @db.VarChar(255)
  status              String                  @default("OPEN") @db.VarChar(30)
  lastChangedByUserId String?                 @map("last_changed_by_user_id") @db.Char(36)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  studentProfile      StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  lastChangedBy       User?                   @relation("SupportStatusChangedBy", fields: [lastChangedByUserId], references: [id], onDelete: SetNull)
  messages            StudentSupportMessage[]

  @@index([studentProfileId, status, updatedAt])
  @@map("student_support_tickets")
}

model StudentSupportMessage {
  id           String               @id @default(uuid()) @db.Char(36)
  ticketId     String               @map("ticket_id") @db.Char(36)
  senderType   String               @map("sender_type") @db.VarChar(20)
  senderUserId String?              @map("sender_user_id") @db.Char(36)
  body         String               @db.Text
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  ticket       StudentSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User?                @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("student_support_messages")
}

model StudentReferral {
  id                String         @id @default(uuid()) @db.Char(36)
  referrerProfileId String         @map("referrer_profile_id") @db.Char(36)
  referredProfileId String         @unique @map("referred_profile_id") @db.Char(36)
  referralCode      String         @map("referral_code") @db.VarChar(40)
  stage             String         @default("REFERRED") @db.VarChar(40)
  rewardStatus      String         @default("NOT_ELIGIBLE") @map("reward_status") @db.VarChar(30)
  rewardAmount      Decimal?       @map("reward_amount") @db.Decimal(12, 2)
  rewardCurrency    String?        @map("reward_currency") @db.Char(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  referrerProfile   StudentProfile @relation("StudentReferralReferrer", fields: [referrerProfileId], references: [id], onDelete: Cascade)
  referredProfile   StudentProfile @relation("StudentReferralReferred", fields: [referredProfileId], references: [id], onDelete: Cascade)

  @@unique([referrerProfileId, referredProfileId])
  @@index([referrerProfileId, stage])
  @@map("student_referrals")
}
