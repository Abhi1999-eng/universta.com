  listingMediaId   String?   @map("listing_media_id") @db.Char(36)
  heroMediaId      String?   @map("hero_media_id") @db.Char(36)
  mapMediaId       String?   @map("map_media_id") @db.Char(36)
  shortDescription String    @map("short_description") @db.VarChar(1000)
  overview         String?   @db.LongText
  featuredLabel    String?   @map("featured_label") @db.VarChar(100)
  tagline          String?   @db.VarChar(500)
  isFeatured       Boolean   @default(false) @map("is_featured")
  isPopular        Boolean   @default(false) @map("is_popular")
  status           String    @default("DRAFT") @db.VarChar(30)
  displayOrder     Int       @default(0) @map("display_order")
  publishedAt      DateTime? @map("published_at") @db.DateTime(3)
  lastVerifiedAt   DateTime? @map("last_verified_at") @db.DateTime(3)
  primarySourceUrl String?   @map("primary_source_url") @db.VarChar(2048)
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  updatedByUserId  String?   @map("updated_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  deletedKey       String    @default("") @map("deleted_key") @db.Char(36)

