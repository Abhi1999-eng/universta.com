  listingMedia         MediaAsset?                 @relation("CountryListingMedia", fields: [listingMediaId], references: [id], onDelete: SetNull)
  heroMedia            MediaAsset?                 @relation("CountryHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  mapMedia             MediaAsset?                 @relation("CountryMapMedia", fields: [mapMediaId], references: [id], onDelete: SetNull)
  createdBy            User?                       @relation("CountryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy            User?                       @relation("CountryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  aliases              CountryAlias[]
  costProfile          CountryCostProfile?
  workProfile          CountryWorkProfile?
  languageRequirements CountryLanguageRequirement?
  intakes              CountryIntake[]
  statistics           CountryStatistic?
  contentSections      CountryContentSection[]
  faqs                 CountryFaq[]
  tagMaps              CountryTagMap[]
  subjectMaps          CountrySubject[]
  states               State[]
  cities               City[]
  courses              CountryCourse[]
  consultantCards      ConsultantLandingCard[]
  popularUniversities  CountryPopularUniversity[]
  popularCourses       CountryPopularCourse[]
  universities         University[]
  scholarshipCountries ScholarshipCountry[]
  consultantCountries  ConsultantCountry[]
  consultantLocations  ConsultantLocation[]
  successStories       SuccessStory[]
  preferredByLeads     Lead[]                      @relation("LeadPreferredCountry")
  jobs                 Job[]                       @relation("JobCountry")
  events               Event[]                     @relation("EventCountry")

  /// Country-owned editorial configuration. These JSON lists intentionally use
